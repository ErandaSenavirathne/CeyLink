      "slide1": {
        "title": "Welcome to CeyLink Provider! 🚀",
        "content": "Let's get your business online and start reaching more local customers."
      },
      "slide2": {
        "title": "Complete Your Profile",
        "content": "Make sure to add a bio, hourly rate, and upload your NIC for verification. Verified providers get a green checkmark and rank higher in search results!"
      },
      "slide3": {
        "title": "Add Your Services",
        "content": "Go to your Profile and add the specific services you offer (e.g., \"Pipe Repair\" under Plumbing). Customers search for these services!"
      },
      "slide4": {
        "title": "Manage Bookings",
        "content": "Customers will send you booking requests. Check your Dashboard to Accept or Reject them. Complete jobs successfully to earn 5-star reviews!"
      },
